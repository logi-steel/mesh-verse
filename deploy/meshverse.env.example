# Copy this file to /etc/mesh-verse/bridge.env and replace the example paths.
# Prefer stable /dev/serial/by-id/... paths on Linux.

MESHTASTIC_PORT=/dev/serial/by-id/replace-with-meshtastic-radio
MESHCORE_PORT=/dev/serial/by-id/replace-with-meshcore-radio
MESHTASTIC_CHANNEL=0
MESHCORE_CHANNEL=0
DEDUPE_SECONDS=120
MAX_TEXT_CHARS=180
